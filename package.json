{
  "name": "snapx-site",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "The SnapX marketing site.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-placeholders.mjs && node scripts/check-secrets.mjs",
    "preview": "vite preview",
    "images": "node scripts/images.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:billing": "node scripts/test-billing.mjs",
    "check:razorpay": "node scripts/check-razorpay-keys.mjs",
    "check": "linkinator dist --recurse --silent --skip \"^(https?://(?!localhost|127\\.0\\.0\\.1)|mailto:)\""
  },
  "devDependencies": {
    "linkinator": "^6.1.2",
    "sharp": "^0.33.5",
    "supabase": "^2.122.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  }
}
