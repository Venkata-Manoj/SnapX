{
  "name": "SnapX",
  "short_name": "SnapX",
  "description": "Snap your fingers on a video call and turn to dust. Your mic mutes. Everything runs on your computer.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F5F2EC",
  "theme_color": "#1E1B17",
  "icons": [
    {
      "src": "favicon-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "icon-128.png",
      "sizes": "128x128",
      "type": "image/png"
    },
    {
      "src": "apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
